# 你自己的 Telegram 数字 ID（可先留空，启动后给 BOT 发消息会回显你的 ID）
ALLOWED_USER_IDS=
ADMIN_USER_IDS=

# 管理 BOT 的 token（在 @BotFather 里 /newbot 创建）
MANAGER_BOT_TOKEN=

# config.yaml 里 token_env 对应的聊天 BOT token
BOT_XIAOZHU_TOKEN=

# 模型服务密钥（用到哪个填哪个）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=ollama
